# Neon pooled URL. connect_timeout=15 rides out Neon waking from scale-to-zero
# (Prisma's 5s default fails with P1001); pgbouncer=true is for the -pooler host.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15&pgbouncer=true"
JWT_SECRET="your_jwt_secret"
PORT="your_port_number"
RAZORPAY_TEST_KEY="your_razorpay_test_key"
RAZORPAY_TEST_SECRET="your_razorpay_test_secret"
# Keep false until digital downloads are built (issue #8); see src/lib/config.ts
DIGITAL_SALES_ENABLED="false"
# Admin image uploads; from the Cloudinary dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
