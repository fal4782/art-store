VITE_API_URL=http://localhost:8000/api/v1
# Razorpay key id (public, used by the checkout popup); same value as the backend's RAZORPAY_TEST_KEY
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
# Keep false until digital downloads are built (issue #8); see backend/src/lib/config.ts
VITE_DIGITAL_SALES_ENABLED=false
